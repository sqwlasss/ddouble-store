# Copy to .env.local and fill in values (never commit .env.local).
# See README.md for details on the Base44 hosted-backend workflow.

# Base44 app (required for frontend-only / hosted-backend workflows)
VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# Optional: backend endpoint that creates/fetches the Shopify customer and
# returns { accessToken, expiresAt }. When unset, no client-side Shopify
# customer sync happens (wishlist syncing is unavailable).
VITE_SHOPIFY_CUSTOMER_SYNC_ENDPOINT=https://your-backend.example.com/sync-shopify-customer

# Optional: Google Maps (used by src/hooks/useGoogleMaps.js). Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=your_key_restricted_by_http_referrer

# Optional: Google Analytics measurement id
VITE_GA_MEASUREMENT_ID=G-XXXXXXX
